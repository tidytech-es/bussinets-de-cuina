---
// Cinta infinita amb les ofertes de la setmana.
// Basada en "Infinite Marquee" de 21st.dev (wensity), portada a CSS pur:
// el contingut es duplica una vegada i es desplaça de 0 a -50 % al compositor.
import type { Dict } from '../i18n/ca';
interface Props { t: Dict }
const { t } = Astro.props;
const items = t.ribbon;
---
<div class="cinta" role="region" aria-label={t.week.title}>
  <div class="cinta__track">
    {[0, 1].map((copy) => (
      <ul class="cinta__group" role="list" aria-hidden={copy === 1 ? 'true' : undefined}>
        {items.map((it) => (
          <li class="cinta__item">
            <span>{it}</span>
            <svg class="cinta__sep" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.5l2.2 6.1 6.3.4-4.9 4 1.6 6.2L12 15.7l-5.2 3.5 1.6-6.2-4.9-4 6.3-.4z" fill="currentColor" /></svg>
          </li>
        ))}
      </ul>
    ))}
  </div>
</div>

<style>
  .cinta {
    position: relative;
    overflow: hidden;
    background: var(--saffron);
    color: var(--ink);
    border-block: 2px solid var(--ink);
    padding-block: 0.9rem;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 6%, #000 94%, transparent);
    mask-image: linear-gradient(to right, transparent, #000 6%, #000 94%, transparent);
  }
  .cinta__track {
    display: flex;
    width: max-content;
    animation: cinta-x 38s linear infinite;
  }
  .cinta__group {
    display: flex;
    flex-shrink: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .cinta__item {
    display: inline-flex;
    align-items: center;
    gap: 1.6rem;
    padding-right: 1.6rem;
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 0.95rem + 0.9vw, 1.6rem);
    line-height: 1.1;
    white-space: nowrap;
  }
  .cinta__sep { width: 1.05em; height: 1.05em; color: var(--tomato); flex: none; }

  @media (hover: hover) and (pointer: fine) {
    .cinta:hover .cinta__track { animation-play-state: paused; }
  }
  @keyframes cinta-x {
    from { transform: translate3d(0, 0, 0); }
    to { transform: translate3d(-50%, 0, 0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .cinta__track { animation: none; }
  }
</style>
