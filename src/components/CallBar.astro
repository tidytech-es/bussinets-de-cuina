---
// Barra fixa a mòbil: trucar sempre a mà.
import { SITE } from '../config/site';
import type { Dict } from '../i18n/ca';
import Icon from './Icon.astro';
interface Props { t: Dict }
const { t } = Astro.props;
---
<nav class="callbar" aria-label={t.callbar.label}>
  <a class="btn callbar__call" href={SITE.phone.href}>
    <Icon name="phone" /> <span>{t.cta.callShort} · {SITE.phone.display}</span>
  </a>
  <a class="btn btn--light callbar__go" href={SITE.directions} target="_blank" rel="noopener" aria-label={t.cta.directions}>
    <Icon name="pin" />
  </a>
</nav>

<style>
  :global(:root) { --callbar-h: calc(4.5rem + env(safe-area-inset-bottom)); }
  .callbar {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 50;
    display: flex;
    gap: 0.6rem;
    padding: 0.65rem var(--gutter) calc(0.65rem + env(safe-area-inset-bottom));
    background: var(--paper);
    border-top: 1px solid var(--line);
    box-shadow: 0 -8px 24px -16px rgb(35 26 18 / 0.35);
  }
  .callbar__call { flex: 1; }
  .callbar__go { flex: none; width: 3.25rem; padding: 0; border-color: var(--ink); }
  @media (min-width: 900px) {
    .callbar { display: none; }
    :global(:root) { --callbar-h: 0px; }
  }
</style>
