---
// Requadre provisional per a una foto que encara no tenim.
// Es veu clarament que és provisional. Es reemplaça des de src/content/plats.ts.
interface Props { name: string; label: string; class?: string }
const { name, label, class: cls } = Astro.props;
---
<div class:list={['slot', cls]} data-todo="foto-pendent" role="img" aria-label={`${label}: ${name}`}>
  <span class="slot__name" aria-hidden="true">{name}</span>
  <span class="slot__tag" aria-hidden="true">{label}</span>
</div>

<style>
  .slot {
    position: relative;
    display: grid;
    place-items: center;
    background:
      radial-gradient(circle at 30% 20%, rgb(255 255 255 / 0.35), transparent 60%),
      var(--kraft);
    color: var(--kraft-ink);
    overflow: hidden;
    isolation: isolate;
    container-type: inline-size;
  }
  .slot::before {
    content: '';
    position: absolute;
    inset: 8px;
    border: 1.5px dashed color-mix(in srgb, var(--kraft-ink) 45%, transparent);
    border-radius: calc(var(--radius) - 6px);
  }
  .slot__name {
    font-family: var(--font-display);
    font-size: clamp(1rem, 16cqi, 3rem);
    line-height: 1;
    text-align: center;
    padding: 1rem;
    opacity: 0.9;
  }
  .slot__tag {
    position: absolute;
    left: 50%;
    bottom: 14px;
    translate: -50% 0;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
    background: var(--paper);
    color: var(--kraft-ink);
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
  }
</style>
