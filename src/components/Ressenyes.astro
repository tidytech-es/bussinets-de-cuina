---
import { SITE } from '../config/site';
import type { Dict } from '../i18n/ca';
import Icon from './Icon.astro';
interface Props { t: Dict }
const { t } = Astro.props;
const r = t.reviews;
const value = SITE.rating.value.toLocaleString(t.htmlLang, { minimumFractionDigits: 1 });
const pct = (SITE.rating.value / 5) * 100;
const [big, small] = r.quotes;
---
<section class="section reviews" id="ressenyes" aria-labelledby="reviews-title">
  <div class="wrap reviews__grid">
    <div class="score" data-reveal>
      <h2 id="reviews-title">{r.title}</h2>
      <p class="score__num">
        <span class="score__value">{value}</span>
        <span class="score__out">{r.outOf}</span>
      </p>
      <div class="stars" role="img" aria-label={r.starsLabel} style={`--pct:${pct}%`}>
        {[0, 1, 2, 3, 4].map(() => <Icon name="star" />)}
        <span class="stars__fill" aria-hidden="true">
          {[0, 1, 2, 3, 4].map(() => <Icon name="star" />)}
        </span>
      </div>
      <p class="score__count">{r.count}</p>
      <a class="link score__link" href={SITE.googleProfile} target="_blank" rel="noopener">{r.link}</a>
    </div>

    <div class="quotes">
      <figure class="quote quote--big" data-reveal style="--i:1">
        <blockquote lang={big.lang}><p>«{big.text}»</p></blockquote>
        <figcaption>{r.source}</figcaption>
      </figure>
      <figure class="quote" data-reveal style="--i:2">
        <blockquote lang={small.lang}><p>«{small.text}»</p></blockquote>
        <figcaption>{r.source}</figcaption>
      </figure>
      <figure class="quote" data-reveal style="--i:3">
        <p>{r.summary.before}<q lang="es">{r.summary.quote}</q>{r.summary.after}</p>
        <figcaption>{r.source}</figcaption>
      </figure>
    </div>
  </div>
</section>

<style>
  .reviews__grid { display: grid; gap: clamp(2.5rem, 1.5rem + 3vw, 4rem); }
  .score { display: grid; gap: 0.75rem; justify-items: start; align-content: start; }
  .score h2 { margin-bottom: 1rem; max-width: 12ch; }
  .score__num { display: flex; align-items: baseline; gap: 0.6rem; line-height: 0.9; }
  .score__value { font-family: var(--font-display); font-size: clamp(5rem, 3rem + 9vw, 9rem); color: var(--tomato); letter-spacing: -0.02em; }
  .score__out { font-size: var(--step-1); color: var(--ink-soft); font-weight: 600; }
  .stars { position: relative; display: inline-flex; gap: 0.2rem; color: var(--line); }
  .stars :global(svg) { width: 1.6rem; height: 1.6rem; flex: none; }
  .stars__fill {
    position: absolute; inset: 0;
    display: inline-flex; gap: 0.2rem;
    color: var(--saffron);
    clip-path: inset(0 calc(100% - var(--pct)) 0 0);
  }
  .score__count { font-weight: 600; }

  .quotes { display: grid; gap: 1.25rem; }
  .quote {
    margin: 0;
    padding: 1.5rem 1.5rem 1.25rem;
    border-radius: var(--radius);
    background: var(--paper-2);
    display: grid;
    gap: 0.9rem;
  }
  .quote blockquote { margin: 0; }
  .quote p { font-size: var(--step-1); line-height: 1.4; }
  .quote q { font-weight: 700; quotes: '«' '»'; }
  .quote--big { background: var(--ink); color: var(--paper); }
  .quote--big p { font-family: var(--font-display); font-size: var(--step-2); line-height: 1.2; }
  .quote figcaption {
    display: inline-flex; align-items: center; gap: 0.5rem;
    font-size: var(--step--1); font-weight: 600; color: var(--ink-soft);
  }
  .quote--big figcaption { color: var(--saffron-soft); }

  @media (min-width: 900px) {
    .reviews__grid { grid-template-columns: 0.85fr 1.15fr; gap: 5rem; align-items: start; }
    .quotes { grid-template-columns: 1fr 1fr; }
    .quote--big { grid-column: 1 / -1; padding: 2rem 2rem 1.5rem; }
  }
</style>
