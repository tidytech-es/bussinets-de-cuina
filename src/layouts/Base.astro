---
import '@fontsource/caprasimo/400.css';
import '@fontsource-variable/schibsted-grotesk';
import '../styles/global.css';
import capraLatin from '@fontsource/caprasimo/files/caprasimo-latin-400-normal.woff2?url';
import { SITE } from '../config/site';
import type { Dict } from '../i18n/ca';

interface Props {
  t: Dict;
  title?: string;
  description?: string;
  path?: string;
  altPath?: string;
  schema?: boolean;
  noindex?: boolean;
}
const { t, title = t.meta.title, description = t.meta.description, path = t.path, altPath = t.other.path, schema = true, noindex = false } = Astro.props;

const canonical = new URL(path, SITE.url).href;
const caUrl = new URL(t.lang === 'ca' ? path : altPath, SITE.url).href;
const esUrl = new URL(t.lang === 'es' ? path : altPath, SITE.url).href;
const og = new URL('/og.jpg', SITE.url).href;

const dayNames = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
const hhmm = (m: number) => `${String(Math.floor(m / 60)).padStart(2, '0')}:${String(m % 60).padStart(2, '0')}`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': ['Restaurant', 'FoodEstablishment'],
  '@id': `${SITE.url}/#negoci`,
  name: SITE.name,
  url: SITE.url,
  image: og,
  telephone: SITE.phone.e164,
  email: SITE.email,
  priceRange: SITE.priceRange,
  servesCuisine: t.lang === 'ca' ? 'Cuina casolana' : 'Cocina casera',
  description,
  address: {
    '@type': 'PostalAddress',
    streetAddress: SITE.address.street,
    postalCode: SITE.address.postalCode,
    addressLocality: SITE.address.city,
    addressRegion: SITE.address.region,
    addressCountry: SITE.address.country,
  },
  hasMap: SITE.googleProfile,
  sameAs: [SITE.facebook],
  openingHoursSpecification: Object.entries(SITE.hours)
    .filter(([, h]) => h)
    .map(([d, h]) => ({
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: `https://schema.org/${dayNames[Number(d)]}`,
      opens: hhmm(h![0]),
      closes: hhmm(h![1]),
    })),
  makesOffer: {
    '@type': 'Offer',
    name: t.week.menu.name,
    description: `${t.week.menu.when}. ${t.week.menu.detail}`,
    price: '7.50',
    priceCurrency: 'EUR',
  },
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: SITE.rating.value,
    bestRating: 5,
    reviewCount: SITE.rating.count,
  },
};

// Textos per a l'indicador obert/tancat (es passen al navegador)
const statusText = {
  open: t.status.open,
  closed: t.status.closed,
  until: t.status.until('{t}'),
  today: t.status.opensToday('{t}'),
  tomorrow: t.status.opensTomorrow('{t}'),
  on: t.status.opensOn('{d}', '{t}'),
  days: t.days,
};
---
<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="ca" href={caUrl} />
    <link rel="alternate" hreflang="es" href={esUrl} />
    <link rel="alternate" hreflang="x-default" href={caUrl} />
    <meta name="theme-color" content="#f5ecdc" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={capraLatin} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={t.locale} />
    <meta property="og:locale:alternate" content={t.lang === 'ca' ? 'es_ES' : 'ca_ES'} />
    <meta name="twitter:card" content="summary_large_image" />

    {schema && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <script is:inline>
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
        document.documentElement.classList.add('js-reveal');
        // Si el JS principal no arriba, ho mostrem tot igualment.
        setTimeout(function () { if (!document.documentElement.dataset.revealReady) document.documentElement.classList.remove('js-reveal'); }, 2500);
      }
    </script>
  </head>
  <body>
    <a class="skip" href="#contingut">{t.skip}</a>
    <slot name="header" />
    <main id="contingut">
      <slot />
    </main>
    <slot name="footer" />

    <script type="application/json" id="status-i18n" set:html={JSON.stringify(statusText)} />
    <script type="application/json" id="status-hours" set:html={JSON.stringify(SITE.hours)} />
    <script>
      import { initStatus } from '../scripts/status';
      import { initReveal } from '../scripts/reveal';
      initStatus();
      initReveal();
    </script>
  </body>
</html>
